<Window x:Class="WebBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Web Browser" Height="800" Width="1200"
        Background="#F5F5F5"
        Icon="Assets/browser-icon.ico"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Top Menu Bar -->
        <StackPanel DockPanel.Dock="Top" Background="White" Margin="0,0,0,1">
            <!-- Navigation Bar -->
            <StackPanel Orientation="Horizontal" Padding="10" Background="#FAFAFA" Gap="8">
                <Button x:Name="BackBtn" Width="40" Height="40"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                        Background="#667eea" Foreground="White" FontSize="16" Cursor="Hand"
                        Click="BackBtn_Click">◀</Button>
                <Button x:Name="ForwardBtn" Width="40" Height="40"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                        Background="#667eea" Foreground="White" FontSize="16" Cursor="Hand"
                        Click="ForwardBtn_Click">▶</Button>
                <Button x:Name="RefreshBtn" Width="40" Height="40"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                        Background="#667eea" Foreground="White" FontSize="16" Cursor="Hand"
                        Click="RefreshBtn_Click">⟳</Button>

                <!-- Address Bar -->
                <TextBox x:Name="AddressBar"
                         Height="35" Padding="10"
                         FontSize="13"
                         PreviewKeyDown="AddressBar_PreviewKeyDown"
                         BorderBrush="#DDD" BorderThickness="1" CornerRadius="5"
                         Background="White" Foreground="#333"/>

                <Button x:Name="GoBtn" Width="50" Height="35"
                        Content="Go" Background="#667eea" Foreground="White"
                        Click="GoBtn_Click" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>

            <!-- Status Bar -->
            <StackPanel Orientation="Horizontal" Padding="10" Background="White" Gap="10" Height="30">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Foreground="#666"/>
                <TextBlock x:Name="LoadTimeText" VerticalAlignment="Center" FontSize="11" Foreground="#999"/>
            </StackPanel>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Content Viewer -->
            <ScrollViewer Grid.Column="0" Margin="0,0,1,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel" Background="White" Padding="15"/>
            </ScrollViewer>

            <!-- Links Sidebar -->
            <Border Grid.Column="1" Background="#F9F9F9" BorderBrush="#DDD" BorderThickness="1,0,0,0">
                <StackPanel>
                    <TextBlock Text="Links" Foreground="#333" FontSize="12" FontWeight="Bold"
                               Padding="10" Background="#E8F4F8" BorderBrush="#DDD" BorderThickness="0,0,0,1"/>
                    <ListBox x:Name="LinksListBox" Background="Transparent" BorderThickness="0"
                             SelectionChanged="LinksListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#667eea"
                                          Cursor="Hand" Padding="8" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
